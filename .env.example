SECRET_KEY=change-me-local-dev-key
# Clave opcional para cifrar secretos LDAP en base.
# Si no se define, se deriva de SECRET_KEY. En produccion conviene una clave estable separada.
LDAP_SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=soc_usecases
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backups PostgreSQL. Los archivos se guardan en ./backups.
POSTGRES_BACKUP_RETENTION_DAYS=14
# En Linux deben coincidir con el UID/GID del usuario dueño de ./backups.
BACKUP_UID=1000
BACKUP_GID=1000

LOG_DIR=/logs

# Produccion detras de HTTPS/reverse proxy
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_AGE=1800
SESSION_SAVE_EVERY_REQUEST=1
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
USE_X_FORWARDED_PROTO=0
USE_X_FORWARDED_FOR=0

# Compatibilidad temporal con rutas viejas bajo /usecases/.
# Usar 0 en staging cuando se quiera validar el retiro definitivo.
ENABLE_LEGACY_USECASE_REDIRECTS=1

# Inventario de equipos activos en Active Directory.
SERVER_INVENTORY_AD_RESOLVE_IP=0
SERVER_INVENTORY_SIEM_USE_PROXY=0
SERVER_INVENTORY_SIEM_RESOLVE_LINUX_NAMES=1
SERVER_INVENTORY_DNS_WORKERS=12
SERVER_INVENTORY_DNS_TIMEOUT=3
SERVER_INVENTORY_JOB_POLL_SECONDS=5
SERVER_INVENTORY_JOB_LEASE_SECONDS=300
SERVER_INVENTORY_JOB_HEARTBEAT_SECONDS=30
SERVER_INVENTORY_JOB_MAX_ATTEMPTS=3
ADMIN_ACTION_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_ACTION_RATE_LIMIT_SYNC=3
ADMIN_ACTION_RATE_LIMIT_MUTATION=30

# Observabilidad y alertas internas.
OPS_JSON_LOGS=1
OPS_COVERAGE_DROP_THRESHOLD=5
OPS_DNS_FAILURE_THRESHOLD=20
OPS_RESOLVED_ALERT_RETENTION_DAYS=180
ADMIN_RATE_LIMIT_RETENTION_DAYS=7
